# ── Required ──────────────────────────────────────────────
# Database (PostgreSQL): Neon / Supabase / Railway or local instance
DATABASE_URL="postgresql://user:password@host:5432/database"

# PII encryption key: 32 bytes base64-encoded (generate with: openssl rand -base64 32)
APP_ENCRYPTION_KEY=""

# VAPID keys for push notifications: generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.pt"

# Cron secret: random string used to authenticate the /api/cron/reminders endpoint
CRON_SECRET=""

# ── Optional ──────────────────────────────────────────────
# App URL (used for sitemap, OG tags, canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prisma migrations: only needed if the migration user differs from DATABASE_URL
# MIGRATE_DATABASE_URL=""

# Email sending (Resend): not yet implemented
# RESEND_API_KEY=""
# EMAIL_FROM="Reserva <reservas@example.pt>"

# ── Seed-only (development only, do NOT use in production) ──
# ADMIN_NAME="Administrador"
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# STAFF_NAME="Colaboradora Exemplo"
# STAFF_EMAIL=""
# STAFF_PASSWORD=""
