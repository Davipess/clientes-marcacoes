// Online booking platform — multi-business-ready schema
// Single business for now; every business-scoped table carries businessId.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Tenancy ──────────────────────────────────────────────

model Business {
  id             String   @id @default(cuid())
  slug           String   @unique // subdomain-ready for future multi-business
  name           String
  logoUrl        String?
  primaryColor   String   @default("#C2185B")
  secondaryColor String   @default("#F8BBD0")
  address        String?
  phone          String?
  email          String?
  timezone       String   @default("Europe/Lisbon")

  settings         BusinessSettings?
  users            User[]
  serviceCategories ServiceCategory[]
  services         Service[]
  staff            Staff[]
  clients          Client[]
  appointments     Appointment[]
  exceptions       AvailabilityException[]
  notificationLogs NotificationLog[]
  pushSubscriptions PushSubscription[]
  loyaltyCards    LoyaltyCard[]
  loyaltyRewards  LoyaltyReward[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyVouchers LoyaltyVoucher[]
  waitlistEntries WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model BusinessSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])

  // Opening hours per weekday: JSON array of intervals per day,
  // e.g. [{ "open": "09:00", "close": "18:00" }]; null = closed.
  openingHours            Json
  bufferMinutes           Int    @default(10) // gap between appointments
  minLeadHours            Int    @default(2) // minimum notice to book
  maxLeadDays             Int    @default(60) // maximum booking horizon
  cancellationPolicyText  String @default("")
  cancellationWindowHours Int    @default(24) // min hours before appt client may cancel/reschedule
  reminderHoursBefore     Int    @default(24)
  notificationEmailText   String? // custom text injected into emails

  // ── Abuse prevention limits (Phase 14) ──
  maxActiveBookingsPerPhone Int @default(3) // future pending/confirmed per phone
  maxBookingsPerPhonePerDay Int @default(3) // new bookings created per day per phone
  noShowFlagThreshold       Int @default(2) // no-shows before the "at risk" badge
  retentionMonths           Int @default(1) // historico da marcacao apagado apos 1 mes
  contactRetentionDays      Int @default(7) // apagar nome/telefone apos a ultima visita

  // ── Editable site copy (white-label) ──
  // Keys with fallbacks in code; owner edits everything in the admin.
  // Shape: { heroTitle, heroSubtitle, heroBadge, aboutTitle, about: [{title,text}],
  //          ctaTitle, ctaSubtitle }
  siteContent Json?

  @@map("business_settings")
}

// ── Users & roles ────────────────────────────────────────

enum Role {
  PLATFORM_OWNER
  ADMIN
  STAFF
  CLIENT
}

model User {
  id           String  @id @default(cuid())
  businessId   String? // null only for PLATFORM_OWNER
  business     Business? @relation(fields: [businessId], references: [id])
  role         Role    @default(CLIENT)
  name         String
  email        String
  passwordHash String? // null = guest client without account (clients never have passwords)
  phone        String?
  image        String?

  passwordResetTokenHash String? // SHA-256 of the reset token; raw token only ever emailed
  passwordResetExpiresAt DateTime?
  twoFactorSecretEnc     String? // AES-256-GCM encrypted TOTP secret (optional, future hardening)

  staffProfile  Staff?
  clientProfile Client?
  sessions      Session[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  @@map("sessions")
}

// ── Staff & schedule ─────────────────────────────────────

model Staff {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  displayName String
  bio         String?
  photoUrl    String?
  active      Boolean  @default(true)

  services     ServiceStaff[] // which services they perform
  workSchedules WorkSchedule[] // weekly recurring hours
  timeOff      TimeOff[] // vacations / days off
  appointments Appointment[]
  blocks       AvailabilityException[]

  @@map("staff")
}

model WorkSchedule {
  id        String @id @default(cuid())
  staffId   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String // "09:00"
  endTime   String // "18:00"

  @@unique([staffId, weekday, startTime])
  @@map("work_schedules")
}

model TimeOff {
  id      String  @id @default(cuid())
  staffId String
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt DateTime
  endAt   DateTime
  reason  String?

  @@map("time_off")
}

// ── Services ─────────────────────────────────────────────

model ServiceCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  services   Service[]

  @@unique([businessId, name])
  @@map("service_categories")
}

model Service {
  id           String          @id @default(cuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id])
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  durationMin  Int // minutes
  price        Decimal         @db.Decimal(10, 2)
  imageUrl     String?
  archived     Boolean         @default(false)
  staff        ServiceStaff[]
  appointmentItems AppointmentItem[]
  waitlistEntries WaitlistEntry[]

  @@map("services")
}

model ServiceStaff {
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@map("service_staff")
}

// ── Clients ──────────────────────────────────────────────

model Client {
  id               String    @id @default(cuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id])
  userId           String?   @unique // set if they created an account
  user             User?     @relation(fields: [userId], references: [id])
  name             String
  // Phone is the sole client identifier (booking limits, no-show protection).
  // PII stored encrypted at rest (AES-256-GCM, key only in app env).
  // phoneEnc e o nome sao APAGADOS apos a visita (minimizacao de dados);
  // phoneHash permanece como identidade pseudonima para anti-abuso.
  phoneEnc         String?
  phoneHash        String
  emailEnc         String? // optional, kept only if a client volunteers it
  emailHash        String?
  notes            String? // admin-only internal notes
  marketingConsent Boolean   @default(false)
  gdprConsentAt    DateTime?

  // ── No-show protection & abuse prevention (Phase 14) ──
  noShowCount Int     @default(0) // persists even after appointment cleanup
  blocked     Boolean @default(false) // manual admin block from online booking
  blockReason String?
  blockedAt   DateTime?

  appointments Appointment[]
  reviews      Review[]
  loyaltyCards LoyaltyCard[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyVouchers LoyaltyVoucher[]
  waitlistEntries WaitlistEntry[]

  @@unique([businessId, phoneHash]) // identity per business
  @@map("clients")
}

// ── Appointments ─────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  ADMIN
  STAFF
}

model Appointment {
  id                 String              @id @default(cuid())
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id])
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  staffId            String
  staff              Staff               @relation(fields: [staffId], references: [id])

  startAt            DateTime
  endAt              DateTime // sum of all services' durations
  status             AppointmentStatus   @default(PENDING)
  source             AppointmentSource   @default(ONLINE)
  notes              String? // client request / admin note
  cancelledAt        DateTime?
  cancellationReason String?

  items         AppointmentItem[] // multiple services in one visit
  notifications NotificationLog[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, staffId, startAt])
  @@index([businessId, clientId, startAt])
  @@map("appointments")
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceName   String // snapshot at booking time
  unitPrice     Decimal     @db.Decimal(10, 2) // snapshot at booking time
  durationMin   Int // snapshot
  sortOrder     Int

  @@map("appointment_items")
}

// ── Availability blocks (holidays, events) ───────────────

model AvailabilityException {
  id        String   @id @default(cuid())
  businessId String
  business  Business @relation(fields: [businessId], references: [id])
  staffId   String? // null = whole business closed
  staff     Staff?   @relation(fields: [staffId], references: [id])
  startAt   DateTime
  endAt     DateTime
  reason    String?

  @@index([businessId, startAt, endAt])
  @@map("availability_exceptions")
}

// ── Notifications & reviews ──────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER
  RESCHEDULED
  CANCELLATION
}

model NotificationLog {
  id            String              @id @default(cuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id])
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  channel       NotificationChannel @default(EMAIL)
  type          NotificationType
  recipient     String
  status        String // SENT | FAILED | QUEUED
  error         String?

  sentAt DateTime @default(now())

  @@map("notification_logs")
}

model Review {
  id            String      @id @default(cuid())
  businessId    String
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@map("reviews") // future phase — model reserved now
}

// Uploaded images stored as bytes (serverless-friendly, no external storage).
model Image {
  id        String   @id @default(cuid())
  businessId String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("images")
}

// Audit trail for sensitive admin/staff actions.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorEmail String
  action     String // e.g. "service.create", "staff.create", "settings.update"
  detail     String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

model PushSubscription {
  id               String @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  userId           String?
  user             User?   @relation(fields: [userId], references: [id])
  clientPhoneHash  String? // for unauthenticated client subscriptions
  endpoint         String
  p256dh           String
  auth             String
  userAgent        String?
  createdAt        DateTime @default(now())

  @@unique([endpoint])
  @@index([businessId])
  @@index([businessId, clientPhoneHash])
  @@map("push_subscriptions")
}

// ── Loyalty program ──────────────────────────────────────────────
model LoyaltyCard {
  id           String  @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id])
  points       Int     @default(0)
  totalEarned  Int     @default(0)
  transactions LoyaltyTransaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, clientId])
  @@map("loyalty_cards")
}

model LoyaltyReward {
  id           String  @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  pointsCost   Int
  description  String?
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@map("loyalty_rewards")
}

model LoyaltyTransaction {
  id           String  @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id])
  cardId       String
  card         LoyaltyCard @relation(fields: [cardId], references: [id])
  appointmentId String?
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  points       Int     // positive = earned, negative = redeemed
  reason       String  // "booking_completed", "reward_redeemed", "bonus"
  createdAt    DateTime @default(now())

  @@index([businessId, clientId])
  @@map("loyalty_transactions")
}

// ── Loyalty vouchers (redeemed rewards) ────────────────────────
model LoyaltyVoucher {
  id           String  @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id])
  rewardName   String
  pointsCost   Int
  status       String  @default("ACTIVE") // ACTIVE, USED
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([businessId, clientId, status])
  @@map("loyalty_vouchers")
}

// ── Waitlist ─────────────────────────────────────────────────────
model WaitlistEntry {
  id           String  @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  clientName   String
  clientPhone  String
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  preferredDate DateTime
  preferredTime String?  // "morning", "afternoon", or specific time
  status       String   @default("WAITING") // WAITING, NOTIFIED, BOOKED, CANCELLED
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([businessId, status])
  @@map("waitlist_entries")
}
